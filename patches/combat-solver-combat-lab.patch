diff --git a/tools/search/OfflineSearchHarness/HeadlessActionPatches.cs b/tools/search/OfflineSearchHarness/HeadlessActionPatches.cs
new file mode 100644
index 00000000..16a7618a
--- /dev/null
+++ b/tools/search/OfflineSearchHarness/HeadlessActionPatches.cs
@@ -0,0 +1,59 @@
+using System.Reflection;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Models.Monsters;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace OfflineSearchHarness;
+
+/// <summary>
+/// Narrow guards for combat actions that still contain a visual-only Godot call
+/// after the game has already entered its test-mode branch.  These are installed
+/// only by the offline host; the game process keeps the original visual behavior.
+/// </summary>
+internal static class HeadlessActionPatches
+{
+    internal static void Install()
+    {
+        MethodInfo soulNexusAfterDeath = AccessTools.Method(
+            typeof(SoulNexus), "AfterDeath", [typeof(Creature)])
+            ?? throw new MissingMethodException(typeof(SoulNexus).FullName, "AfterDeath");
+        GameBootstrap.Harmony.Patch(
+            soulNexusAfterDeath,
+            prefix: new HarmonyMethod(typeof(HeadlessActionPatches), nameof(SkipSoulNexusDeathVisualPrefix)));
+
+        MethodInfo decimillipedeReattach = AccessTools.Method(
+            typeof(DecimillipedeSegment), "ReattachMove")
+            ?? throw new MissingMethodException(typeof(DecimillipedeSegment).FullName, "ReattachMove");
+        GameBootstrap.Harmony.Patch(
+            decimillipedeReattach,
+            prefix: new HarmonyMethod(typeof(HeadlessActionPatches), nameof(SkipDecimillipedeReattachVisualPrefix)));
+    }
+
+    private static bool SkipSoulNexusDeathVisualPrefix(SoulNexus __instance)
+    {
+        if (!TestMode.IsOn)
+            return true;
+
+        // The original handler removes itself before touching NCombatRoom. Keep
+        // that lifecycle behavior even when the visual animation is omitted.
+        MethodInfo handlerMethod = AccessTools.Method(typeof(SoulNexus), "AfterDeath", [typeof(Creature)])
+            ?? throw new MissingMethodException(typeof(SoulNexus).FullName, "AfterDeath");
+        Action<Creature> handler = (Action<Creature>)Delegate.CreateDelegate(
+            typeof(Action<Creature>), __instance, handlerMethod);
+        __instance.Creature.Died -= handler;
+        return false;
+    }
+
+    private static bool SkipDecimillipedeReattachVisualPrefix(ref Task __result)
+    {
+        if (!TestMode.IsOn)
+            return true;
+
+        // ReattachMove already skips gameplay reattachment when the combat is
+        // not live, but unconditionally loads a phobia texture afterwards.
+        // In a process without Godot that ResourceLoader call is a native crash.
+        __result = Task.CompletedTask;
+        return false;
+    }
+}
diff --git a/tools/search/OfflineSearchHarness/HeadlessSavePatches.cs b/tools/search/OfflineSearchHarness/HeadlessSavePatches.cs
new file mode 100644
index 00000000..3da394b4
--- /dev/null
+++ b/tools/search/OfflineSearchHarness/HeadlessSavePatches.cs
@@ -0,0 +1,111 @@
+using System.Reflection;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Relics;
+using MegaCrit.Sts2.Core.Saves.Runs;
+
+namespace OfflineSearchHarness;
+
+/// <summary>
+/// Save properties are gameplay state, but a few model setters also prepare UI
+/// hover tips.  The offline host has no Godot resource loader, so keep the
+/// saved model ids while omitting only that display-only preparation.
+/// </summary>
+internal static class HeadlessSavePatches
+{
+    private static readonly FieldInfo StarterRelicField = AccessTools.Field(
+        typeof(TouchOfOrobas), "_starterRelic")
+        ?? throw new MissingFieldException(typeof(TouchOfOrobas).FullName, "_starterRelic");
+
+    private static readonly FieldInfo UpgradedRelicField = AccessTools.Field(
+        typeof(TouchOfOrobas), "_upgradedRelic")
+        ?? throw new MissingFieldException(typeof(TouchOfOrobas).FullName, "_upgradedRelic");
+
+    private static readonly FieldInfo ArchaicStarterCardField = AccessTools.Field(
+        typeof(ArchaicTooth), "_serializableStarterCard")
+        ?? throw new MissingFieldException(typeof(ArchaicTooth).FullName, "_serializableStarterCard");
+
+    private static readonly FieldInfo ArchaicAncientCardField = AccessTools.Field(
+        typeof(ArchaicTooth), "_serializableAncientCard")
+        ?? throw new MissingFieldException(typeof(ArchaicTooth).FullName, "_serializableAncientCard");
+
+    private static readonly FieldInfo DustyAncientCardField = AccessTools.Field(
+        typeof(DustyTome), "_ancientCard")
+        ?? throw new MissingFieldException(typeof(DustyTome).FullName, "_ancientCard");
+
+    internal static void Install()
+    {
+        MethodInfo starterSetter = AccessTools.PropertySetter(
+            typeof(TouchOfOrobas), nameof(TouchOfOrobas.StarterRelic))
+            ?? throw new MissingMethodException(typeof(TouchOfOrobas).FullName, "set_StarterRelic");
+        MethodInfo upgradedSetter = AccessTools.PropertySetter(
+            typeof(TouchOfOrobas), nameof(TouchOfOrobas.UpgradedRelic))
+            ?? throw new MissingMethodException(typeof(TouchOfOrobas).FullName, "set_UpgradedRelic");
+        GameBootstrap.Harmony.Patch(
+            starterSetter,
+            prefix: new HarmonyMethod(typeof(HeadlessSavePatches), nameof(SetStarterRelicPrefix)));
+        GameBootstrap.Harmony.Patch(
+            upgradedSetter,
+            prefix: new HarmonyMethod(typeof(HeadlessSavePatches), nameof(SetUpgradedRelicPrefix)));
+
+        MethodInfo archaicStarterSetter = AccessTools.PropertySetter(
+            typeof(ArchaicTooth), nameof(ArchaicTooth.StarterCard))
+            ?? throw new MissingMethodException(typeof(ArchaicTooth).FullName, "set_StarterCard");
+        MethodInfo archaicAncientSetter = AccessTools.PropertySetter(
+            typeof(ArchaicTooth), nameof(ArchaicTooth.AncientCard))
+            ?? throw new MissingMethodException(typeof(ArchaicTooth).FullName, "set_AncientCard");
+        GameBootstrap.Harmony.Patch(
+            archaicStarterSetter,
+            prefix: new HarmonyMethod(typeof(HeadlessSavePatches), nameof(SetArchaicStarterCardPrefix)));
+        GameBootstrap.Harmony.Patch(
+            archaicAncientSetter,
+            prefix: new HarmonyMethod(typeof(HeadlessSavePatches), nameof(SetArchaicAncientCardPrefix)));
+
+        MethodInfo dustyAncientSetter = AccessTools.PropertySetter(
+            typeof(DustyTome), nameof(DustyTome.AncientCard))
+            ?? throw new MissingMethodException(typeof(DustyTome).FullName, "set_AncientCard");
+        GameBootstrap.Harmony.Patch(
+            dustyAncientSetter,
+            prefix: new HarmonyMethod(typeof(HeadlessSavePatches), nameof(SetDustyAncientCardPrefix)));
+    }
+
+    private static bool SetStarterRelicPrefix(TouchOfOrobas __instance, ModelId? value)
+    {
+        SetSavedField(StarterRelicField, __instance, value, "StarterRelic");
+        return false;
+    }
+
+    private static bool SetUpgradedRelicPrefix(TouchOfOrobas __instance, ModelId? value)
+    {
+        SetSavedField(UpgradedRelicField, __instance, value, "UpgradedRelic");
+        return false;
+    }
+
+    private static bool SetArchaicStarterCardPrefix(ArchaicTooth __instance, SerializableCard? value)
+    {
+        __instance.AssertMutable();
+        ArchaicStarterCardField.SetValue(__instance, value);
+        return false;
+    }
+
+    private static bool SetArchaicAncientCardPrefix(ArchaicTooth __instance, SerializableCard? value)
+    {
+        __instance.AssertMutable();
+        ArchaicAncientCardField.SetValue(__instance, value);
+        return false;
+    }
+
+    private static bool SetDustyAncientCardPrefix(DustyTome __instance, ModelId? value)
+    {
+        __instance.AssertMutable();
+        DustyAncientCardField.SetValue(__instance, value);
+        return false;
+    }
+
+    private static void SetSavedField(FieldInfo field, TouchOfOrobas instance, ModelId? value, string name)
+    {
+        if (field.GetValue(instance) is not null)
+            throw new InvalidOperationException($"Recursive Core setup called twice for {name}!");
+        field.SetValue(instance, value);
+    }
+}
diff --git a/tools/search/OfflineSearchHarness/ImportedPlayerState.cs b/tools/search/OfflineSearchHarness/ImportedPlayerState.cs
new file mode 100644
index 00000000..f6e7a694
--- /dev/null
+++ b/tools/search/OfflineSearchHarness/ImportedPlayerState.cs
@@ -0,0 +1,67 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.Saves;
+using MegaCrit.Sts2.Core.Saves.Runs;
+
+namespace OfflineSearchHarness;
+
+/// <summary>Combat Lab's serialized loadout is applied before native room entry.</summary>
+internal sealed class ImportedPlayerState
+{
+    private readonly JsonObject _data;
+
+    private ImportedPlayerState(JsonObject data) => _data = data;
+
+    public static ImportedPlayerState? FromRequest(string requestPath)
+    {
+        using JsonDocument request = JsonDocument.Parse(File.ReadAllText(requestPath));
+        if (!request.RootElement.TryGetProperty("combatLabPlayerStatePath", out JsonElement path))
+            return null;
+        string filename = path.GetString() ?? throw new InvalidDataException("Missing imported player state path.");
+        JsonObject data = JsonNode.Parse(File.ReadAllText(filename))?.AsObject()
+            ?? throw new InvalidDataException("Empty imported player state.");
+        if (data["schemaVersion"]?.GetValue<int>() != 1)
+            throw new InvalidDataException("Unsupported imported player state schema.");
+        return new ImportedPlayerState(data);
+    }
+
+    public void Apply(RunState run, Player player)
+    {
+        JsonObject patch = _data["player"]?.AsObject()
+            ?? throw new InvalidDataException("Imported state has no player.");
+        JsonObject baseline = JsonSerializer.SerializeToNode(player.ToSerializable(),
+            JsonSerializationUtility.GetTypeInfo<SerializablePlayer>())!.AsObject();
+        string[] fields = ["current_hp", "max_hp", "gold", "max_energy", "max_potion_slot_count",
+            "base_orb_slot_count", "deck", "relics", "potions", "extra_fields"];
+        foreach (string field in fields)
+            if (patch.TryGetPropertyValue(field, out JsonNode? value))
+                baseline[field] = value?.DeepClone();
+        SerializablePlayer imported = JsonSerializer.Deserialize(baseline.ToJsonString(),
+            JsonSerializationUtility.GetTypeInfo<SerializablePlayer>())
+            ?? throw new InvalidDataException("Cannot deserialize imported player.");
+        if (imported.MaxHp < 1 || imported.CurrentHp < 1 || imported.CurrentHp > imported.MaxHp)
+            throw new InvalidDataException("Imported player must be alive with valid HP.");
+        if (imported.MaxPotionSlotCount < 0 || imported.MaxEnergy < 0 || imported.Gold < 0 || imported.BaseOrbSlotCount < 0)
+            throw new InvalidDataException("Imported player has negative stats.");
+        if (imported.Potions.Select(p => p.SlotIndex).Distinct().Count() != imported.Potions.Count
+            || imported.Potions.Any(p => p.SlotIndex < 0 || p.SlotIndex >= imported.MaxPotionSlotCount))
+            throw new InvalidDataException("Imported potion slots are invalid.");
+        // Sync restores inventories silently. Relic pickup effects are already in
+        // the saved HP/gold/capacity and must not be applied a second time.
+        player.SyncWithSerializedPlayer(imported);
+        player.BaseOrbSlotCount = imported.BaseOrbSlotCount;
+        if (_data.TryGetPropertyValue("map_point_history", out JsonNode? history))
+        {
+            var wrapper = new JsonObject { ["map_point_history"] = history?.DeepClone() };
+            SerializableRun saved = JsonSerializer.Deserialize(wrapper.ToJsonString(),
+                JsonSerializationUtility.GetTypeInfo<SerializableRun>())
+                ?? throw new InvalidDataException("Cannot deserialize imported history.");
+            run._mapPointHistory.Clear();
+            run._mapPointHistory.AddRange(saved.MapPointHistory);
+        }
+        if (_data["actFloor"] is JsonNode floor)
+            run.ActFloor = Math.Max(1, floor.GetValue<int>());
+    }
+}
