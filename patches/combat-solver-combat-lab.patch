+        {
+            throw new InvalidDataException(
+                $"快照幕索引 {save.CurrentActIndex} 与请求 actIndexForTest {request.ActIndexForTest} 不一致。");
+        }
+
+        RunState restored = RunState.FromSerializable(save);
+        await RunManager.Instance.SetUpSavedSingleplayer(restored, save);
+        RunManager.Instance.Launch();
+        // InitializeSavedRun 保留了保存的 SerializableActMap；GenerateMap 会消费它，
+        // 因此不会用当前进程的 RNG 重新生成地图。
